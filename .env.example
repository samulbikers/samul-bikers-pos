# Copy to .env.local and fill in from the Supabase dashboard (Project settings → API).
# Both values are public browser keys; never put the service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# PayHero M-Pesa checkout (defaults are the shop's live Lipwa account)
VITE_PAYHERO_PAYMENT_URL=https://lipwa.link/13691/p/22lU7iHz
VITE_PAYHERO_CHANNEL_ID=14988
